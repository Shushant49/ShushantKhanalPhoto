@{
    Layout = "_Layout";
}

<div class="about-page">
    <div class="about-grid">
        <!-- About Image -->
        <div class="about-image-wrap">
            <img src="https://images.unsplash.com/photo-1554048612-b6a482bc67e5?w=800" alt="Photographer at work" />
        </div>

        <!-- About Content -->
        <div class="about-content">
            <div class="about-eyebrow">About Me</div>
            <h1 class="about-title">Hi, I'm Shushant Khanal</h1>

            <p class="about-bio">I'm a photographer based in the Midwest, specializing in portrait and nature photography. I started my photography journey in 2020 and have been in love with this form of art ever since.</p>

            <p class="about-bio">I have done various event shoots including <b>graduation</b>, <b>prom</b>, and <b>wedding</b>. I use Sony a<i>7iii</i> in my sessions.</p>

            <div class="about-stats">
                <div>
                    <div class="stat-num">6+</div>
                    <div class="stat-label">Years Experience</div>
                </div>
                <div>
                    <div class="stat-num">&#8734</div>
                    <div class="stat-label">Memories</div>
                </div>
            </div>

            <p class="about-bio">When I'm not behind the camera, I am writing codes, developing softwares, and enjoying various sports.</p>

            <div style="margin-top: 40px;">
                <a href="@Url.Action("Index", "Gallery")" class="btn">View My Work</a>
                <a href="@Url.Action("Index", "Contact")" class="btn" style="margin-left: 12px;">Get In Touch</a>
            </div>
        </div>
    </div>
</div>