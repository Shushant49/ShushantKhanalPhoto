@model ShushantKhanalPhoto.Models.BookingRequest
@{
    Layout = "_Layout";
}

<div class="contact-page">
    <div style="max-width: 800px; margin: 0 auto;">
        <!-- Back to Contact -->
        <div style="margin-bottom: 32px;">
            <a href="@Url.Action("Index", "Contact")" style="font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);">← Back to Contact</a>
        </div>

        <!-- Booking Header -->
        <div style="text-align: center; margin-bottom: 60px;">
            <div style="font-size: 0.68rem; letter-spacing: 0.3em; text-transform: uppercase; color: var(--accent); margin-bottom: 16px;">Book a Session</div>
            <h1 style="font-family: var(--font-display); font-size: 3.2rem; font-weight: 300; line-height: 1.1; margin-bottom: 20px;">Tell Me About Your Project</h1>
            <p style="color: var(--muted); font-size: 1rem; line-height: 1.8; max-width: 560px; margin: 0 auto;">Fill out the form below and I'll get back to you within 24 hours with availability, pricing details, and next steps.</p>
        </div>

        <!-- Booking Form -->
        <div style="background: var(--bg3); border: 1px solid var(--border); border-radius: 16px; padding: 48px;">
            <div style="background: var(--bg3); border: 1px solid var(--border); border-radius: 16px; padding: 48px;">
            <form asp-controller="Booking" asp-action="Submit" method="post" class="booking-form">
                <div class="form-row">
                    <div class="form-group">
                        <label for="Name">Your Name *</label>
                        <input type="text" id="Name" name="Name" required placeholder="FirstName LastName" />
                        <span class="text-danger field-validation-error" data-valmsg-for="Name" data-valmsg-replace="true"></span>
                    </div>

                    <div class="form-group">
                        <label for="Email">Email Address *</label>
                        <input type="email" id="Email" name="Email" required placeholder="youremail@example.com" />
                        <span class="text-danger field-validation-error" data-valmsg-for="Email" data-valmsg-replace="true"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label for="Phone">Phone Number (Optional)</label>
                    <input type="tel" id="Phone" name="Phone" placeholder="+1 (888) 123-4567" />
                </div>

                <div class="form-group">
                    <label for="SessionType">Session Type *</label>
                    <select id="SessionType" name="SessionType" required>
                        <option value="">Choose a session type</option>
                        <option value="Portrait">Portrait Session</option>
                        <option value="Event">Event Coverage</option>
                        <option value="Commercial">Commercial Project</option>
                        <option value="Editorial">Editorial Work</option>
                        <option value="Landscape">Wildlife / Nature</option>
                        <option value="Other">Other / Not Sure</option>
                    </select>
                    <span class="text-danger field-validation-error" data-valmsg-for="SessionType" data-valmsg-replace="true"></span>
                </div>

                <div class="form-row">
                    <div class="form-group">
                        <label for="PreferredDate">Preferred Date (Optional)</label>
                        <input type="date" id="PreferredDate" name="PreferredDate" />
                    </div>

                    <div class="form-group">
                        <label for="PreferredTime">Preferred Time (Optional)</label>
                        <input type="time" id="PreferredTime" name="PreferredTime" />
                    </div>
                </div>

                <div class="form-group">
                    <label for="Message">Project Details (Optional)</label>
                    <textarea id="Message" name="Message" placeholder="Tell me about your vision, location preferences, number of people, timeline, budget range, or any other details that would help me understand your project better..." rows="6"></textarea>
                </div>

                <div style="background: rgba(200,169,110,0.08); border-left: 3px solid var(--accent); padding: 16px 20px; border-radius: 6px; margin-bottom: 28px;">
                    <div style="font-size: 0.85rem; color: var(--muted); line-height: 1.6;">
                        <strong style="color: var(--text);">What happens next?</strong><br/>
                        I'll review your request and respond within 24 hours with my availability, package options, and pricing. We can then schedule a call to discuss your project in detail.
                    </div>
                </div>

                <button type="submit" class="btn btn-solid" style="width: 100%; font-size: 0.8rem; padding: 18px;">Send Booking Request</button>

                <div style="text-align: center; margin-top: 20px; font-size: 0.8rem; color: var(--muted);">
                        Questions? Email me directly at <a href="mailto:khanalshushant49@gmail.com" style="color: var(--accent);">khanalshushant49@gmail.com</a>
                </div>
            </form>
        </div>
    </div>
</div>

