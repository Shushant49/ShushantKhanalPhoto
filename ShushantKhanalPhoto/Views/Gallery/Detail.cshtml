@model ShushantKhanalPhoto.Models.Photo
@{
    Layout = "_Layout";
}

<div class="gallery-page" style="max-width: 1200px; margin: 0 auto;">
    <!-- Back to Gallery -->
    <div style="margin-bottom: 32px;">
        <a href="@Url.Action("Index", "Gallery")" style="font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent);">← Back to Gallery</a>
    </div>

    <!-- Photo Detail -->
    <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 60px; align-items: start;">
        <!-- Main Image -->
        <div>
            <img src="@Model.ImageUrl" alt="@Model.Title" style="width: 100%; height: auto; border: 1px solid var(--border);" />
        </div>

        <!-- Photo Info -->
        <div>
            <div style="font-size: 0.65rem; letter-spacing: 0.25em; text-transform: uppercase; color: var(--accent); margin-bottom: 12px;">@Model.Category</div>
            <h1 style="font-family: var(--font-display); font-size: 2.8rem; font-weight: 300; margin-bottom: 20px;">@Model.Title</h1>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p style="color: var(--muted); line-height: 1.8; margin-bottom: 32px;">@Model.Description</p>
            }

            <div style="border-top: 1px solid var(--border); padding-top: 20px; margin-bottom: 32px;">
                <div style="font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px;">Date Taken</div>
                <div>@Model.DateTaken.ToString("MMMM dd, yyyy")</div>
            </div>

            @if (Model.IsFeatured)
            {
                <div style="display: inline-block; background: rgba(200,169,110,0.15); color: var(--accent); padding: 6px 16px; border-radius: 20px; font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 24px;">
                    ⭐ Featured
                </div>
            }

            <div style="margin-bottom: 24px;">
                <a href="@Url.Action("Index", "Booking")" class="btn btn-solid" style="width: 100%; text-align: center;">Book a Session</a>
            </div>

            <div style="margin-bottom: 24px;">
                <a href="@Url.Action("Index", "Contact")" class="btn" style="width: 100%; text-align: center;">Contact Me</a>
            </div>

            <!-- Related Photos -->
            @if (ViewBag.Related != null && ((List<ShushantKhanalPhoto.Models.Photo>)ViewBag.Related).Count > 0)
            {
                <div style="margin-top: 60px;">
                    <h3 style="font-family: var(--font-display); font-size: 1.4rem; font-weight: 300; margin-bottom: 20px;">More from @Model.Category</h3>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px;">
                        @foreach (var related in (List<ShushantKhanalPhoto.Models.Photo>)ViewBag.Related)
                        {
                            <a href="@Url.Action("Detail", "Gallery", new { id = related.Id })" style="position: relative; overflow: hidden; aspect-ratio: 4/3;">
                                <img src="@related.ImageUrl" alt="@related.Title" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'" />
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

